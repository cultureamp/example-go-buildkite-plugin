{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "go@1.20.14",
    "golangci-lint@1.62.2"
  ],
  "shell": {
    "scripts": {
      "setup": [
        "(cd src && go mod download)"
      ],
      "check": [
        "(cd src && golangci-lint run --timeout=2m)",
        "(cd src && go test ./...)"
      ],
      "verify": [
        "(cd src && make ensure-deps)",
        "(cd src && golangci-lint run --timeout=2m)",
        "(cd src && go test -race -cover ./...)"
      ]
    }
  }
}
